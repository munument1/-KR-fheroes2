msgid "This file contains a save with an invalid game type."
msgstr "이 파일에는 올바르지 않은 게임 유형의 저장 데이터가 들어 있습니다."

msgid "This save file requires \"The Price of Loyalty\" game assets, but they have not been provided to the engine."
msgstr "이 저장 파일에는 \"충성의 대가\" 게임 데이터가 필요하지만 엔진에 제공되지 않았습니다."

msgid "This saved game is localized to '"
msgstr "이 저장 게임의 현지화 언어는 '"

msgid " language, but the current language of the game is '"
msgstr "이지만 현재 게임 언어는 '"

msgid "No save files to load."
msgstr "불러올 저장 파일이 없습니다."

msgid "A single player game playing out a single map."
msgstr "하나의 맵을 플레이하는 싱글플레이 게임입니다."

msgid "Standard Game"
msgstr "표준 게임"

msgid "A single player game playing through a series of maps."
msgstr "여러 맵으로 이어진 시리즈를 플레이하는 싱글플레이 게임입니다."

msgid "Campaign Game"
msgstr "캠페인 게임"

msgid "Multi-Player Game"
msgstr "멀티플레이 게임"

msgid "A multi-player game, with several human players completing against each other on a single map."
msgstr "여러 인간 플레이어가 한 맵에서 서로 경쟁하는 멀티플레이 게임입니다."

msgid "Hot Seat"
msgstr "핫시트"

msgid "Play a Hot Seat game, where 2 to 6 players play around the same computer, switching into the 'Hot Seat' when it is their turn."
msgstr "2~6명이 한 컴퓨터에서 함께 플레이하며 자신의 턴마다 자리를 바꾸는 핫시트 게임을 합니다."

msgid "Cancel back to the main menu."
msgstr "취소하고 주 메뉴로 돌아갑니다."

msgid "Welcome to Heroes of Might and Magic II powered by fheroes2 engine!"
msgstr "fheroes2 엔진으로 구동되는 히어로즈 오브 마이트 앤 매직 II에 오신 것을 환영합니다!"

msgid "\n\nTo simulate a right-click with a touch to get info on various items, you need to first touch and keep touching on the item of interest and then touch anywhere else on the screen. While holding the second finger, you can remove the first one from the screen and keep viewing the information on the item."
msgstr "\n\n터치 화면에서 우클릭을 흉내 내어 여러 항목의 정보를 보려면, 먼저 원하는 항목을 계속 누른 채 화면의 다른 곳을 두 번째 손가락으로 터치하세요. 두 번째 손가락을 누른 채 첫 번째 손가락을 떼어도 해당 항목의 정보를 계속 볼 수 있습니다."

msgid "\n\nBefore starting the game, please select a game resolution."
msgstr "\n\n게임을 시작하기 전에 게임 해상도를 선택하세요."

msgid "Greetings!"
msgstr "환영합니다!"

msgid "Quit Heroes of Might and Magic II and return to the operating system."
msgstr "히어로즈 오브 마이트 앤 매직 II를 종료하고 운영체제로 돌아갑니다."

msgid "Credits"
msgstr "제작진"

msgid "View the credits screen."
msgstr "제작진 화면을 봅니다."

msgid "View the high scores screen."
msgstr "최고 점수 화면을 봅니다."

msgid "Create new or modify existing maps."
msgstr "새 맵을 만들거나 기존 맵을 수정합니다."

msgid "Change language, resolution and settings of the game."
msgstr "게임의 언어, 해상도와 설정을 변경합니다."

msgid "Game Settings"
msgstr "게임 설정"

msgid "The required video files for the campaign selection window are missing. Please make sure that all necessary files are present in the system."
msgstr "캠페인 선택 화면에 필요한 영상 파일이 없습니다. 필요한 파일이 시스템에 모두 있는지 확인하세요."

msgid "Loading video. Please wait..."
msgstr "영상 불러오는 중. 잠시만 기다려 주세요..."

msgid "fheroes2 needs data files from the original Heroes of Might and Magic II to operate. You appear to be using the demo version of Heroes of Might and Magic II for this purpose. Please note that only one scenario will be available in this setup."
msgstr "fheroes2를 실행하려면 원본 히어로즈 오브 마이트 앤 매직 II의 데이터 파일이 필요합니다. 현재 데모 버전의 데이터를 사용하는 것으로 보입니다. 이 경우 시나리오는 하나만 사용할 수 있습니다."

msgid "A multi-player game, with several human players competing against each other on a single map."
msgstr "여러 인간 플레이어가 한 맵에서 서로 경쟁하는 멀티플레이 게임입니다."

msgid "Setup and play a battle without loading any map."
msgstr "맵을 불러오지 않고 전투를 설정하고 플레이합니다."

msgid "2 Players"
msgstr "2인"

msgid "Play with 2 human players, and optionally, up to 4 additional computer players."
msgstr "인간 플레이어 2명과 선택적으로 컴퓨터 플레이어 최대 4명까지 함께 플레이합니다."

msgid "3 Players"
msgstr "3인"

msgid "Play with 3 human players, and optionally, up to 3 additional computer players."
msgstr "인간 플레이어 3명과 선택적으로 컴퓨터 플레이어 최대 3명까지 함께 플레이합니다."

msgid "4 Players"
msgstr "4인"

msgid "Play with 4 human players, and optionally, up to 2 additional computer players."
msgstr "인간 플레이어 4명과 선택적으로 컴퓨터 플레이어 최대 2명까지 함께 플레이합니다."

msgid "5 Players"
msgstr "5인"

msgid "Play with 5 human players, and optionally, up to 1 additional computer player."
msgstr "인간 플레이어 5명과 선택적으로 컴퓨터 플레이어 최대 1명까지 함께 플레이합니다."

msgid "6 Players"
msgstr "6인"

msgid "Play with 6 human players."
msgstr "인간 플레이어 6명이 함께 플레이합니다."

msgid "Original Campaign"
msgstr "오리지널 캠페인"

msgid "Either Roland's or Archibald's campaign from the original Heroes of Might and Magic II."
msgstr "원본 히어로즈 오브 마이트 앤 매직 II의 롤랜드 또는 아치볼드 캠페인을 플레이합니다."

msgid "Expansion Campaign"
msgstr "확장팩 캠페인"

msgid "One of the four new campaigns from the Price of Loyalty expansion set."
msgstr "\"충성의 대가\" 확장팩에 포함된 네 개의 새 캠페인 중 하나를 플레이합니다."

msgid "Play a Hot Seat game, where 2 to 6 players play on the same device, switching into the 'Hot Seat' when it is their turn."
msgstr "2~6명이 같은 기기에서 함께 플레이하며 자신의 턴마다 자리를 바꾸는 핫시트 게임을 합니다."

msgid "Dragon city has fallen! You are now the Master of the Dragons."
msgstr "드래곤 시티가 함락되었습니다! 이제 당신은 드래곤의 지배자입니다."

msgid "You captured %{name}!\nYou are victorious."
msgstr "%{name}을(를) 점령했습니다!\n승리했습니다."

msgid "You have captured the enemy hero %{name}!\nYour quest is complete."
msgstr "적 영웅 %{name}을(를) 사로잡았습니다!\n임무를 완수했습니다."

msgid "You have found the %{name}.\nYour quest is complete."
msgstr "%{name}을(를) 찾았습니다.\n임무를 완수했습니다."

msgid "Ultimate Artifact"
msgstr "궁극의 아티팩트"

msgid "The enemy is beaten.\nYour side has triumphed!"
msgstr "적이 패배했습니다.\n아군 진영이 승리했습니다!"

msgid "You have built up over %{count} gold in your treasury.\nAll enemies bow before your wealth and power."
msgstr "국고에 %{count}골드가 넘게 쌓였습니다.\n모든 적이 당신의 부와 권력 앞에 굴복합니다."

msgid "Victory!"
msgstr "승리!"

msgid "The enemy has captured %{name}!\nThey are triumphant."
msgstr "적이 %{name}을(를) 점령했습니다!\n적이 승리했습니다."

msgid "The enemy has found the %{name}.\nYour quest is a failure."
msgstr "적이 %{name}을(를) 찾았습니다.\n임무에 실패했습니다."

msgid "The enemy has built up over %{count} gold in his treasury.\nYou must bow done in defeat before his wealth and power."
msgstr "적의 국고에 %{count}골드가 넘게 쌓였습니다.\n그 부와 권세 앞에 패배를 인정할 수밖에 없습니다."

msgid "You have been eliminated from the game!!!"
msgstr "게임에서 탈락했습니다!!!"

msgid "You have lost the hero %{name}.\nYour quest is over."
msgstr "영웅 %{name}을(를) 잃었습니다.\n임무는 끝났습니다."

msgid "You have failed to complete your quest in time.\nAll is lost."
msgstr "제한 시간 안에 임무를 완수하지 못했습니다.\n모든 것을 잃었습니다."

msgid "Defeat!"
msgstr "패배!"

msgid "Base score: %{score}\nDifficulty: %{difficulty}\n\n"
msgstr "기본 점수: %{score}\n난이도: %{difficulty}\n\n"

msgid "Defeat all enemy heroes and capture all enemy towns and castles."
msgstr "모든 적 영웅을 격파하고 모든 적 마을과 성을 점령합니다."

msgid "Your side defeats the opposing side."
msgstr "아군 진영이 상대 진영을 격파합니다."

msgid "Run out of time. (Fail to win by a certain point.)"
msgstr "시간이 다 됩니다. 정해진 시점까지 승리하지 못합니다."

msgid "You must defeat the enemy %{enemies}."
msgid_plural "You must defeat the enemy alliance of %{enemies}."
msgstr[0] "%{enemies} 적 동맹을 격파해야 합니다."

msgid "The alliance consisting of %{allies} and you must defeat the enemy %{enemies}."
msgid_plural "The alliance consisting of %{allies} and you must defeat the enemy alliance of %{enemies}."
msgstr[0] "%{allies}와(과) 당신이 속한 동맹이 %{enemies} 적 동맹을 격파해야 합니다."

msgid "Capture the castle '%{name}'."
msgstr "%{name}' 성을 점령합니다."

msgid "Capture the town '%{name}'."
msgstr "%{name}' 마을을 점령합니다."

msgid "Defeat the hero '%{name}'."
msgstr "%{name}' 영웅을 격파합니다."

msgid "Find the ultimate artifact."
msgstr "궁극의 아티팩트를 찾습니다."

msgid "Find the '%{name}' artifact."
msgstr "%{name}' 아티팩트를 찾습니다."

msgid "Accumulate %{count} gold."
msgstr "%{count}골드를 모읍니다."

msgid ", or you may win by defeating all enemy heroes and capturing all enemy towns and castles."
msgstr ", 또는 모든 적 영웅을 격파하고 모든 적 마을과 성을 점령해도 승리할 수 있습니다."

msgid "Lose the castle '%{name}'."
msgstr "%{name}' 성을 잃습니다."

msgid "Lose the town '%{name}'."
msgstr "%{name}' 마을을 잃습니다."

msgid "Lose the hero: %{name}."
msgstr "영웅 %{name}을(를) 잃습니다."

msgid "Fail to win by the end of month %{month}, week %{week}, day %{day}."
msgstr "%{month}월 %{week}주 %{day}일까지 승리하지 못합니다."

msgid "%{color} player has been vanquished!"
msgstr "%{color} 플레이어가 패배했습니다!"

msgid "Major Event!"
msgstr "중대 사건!"

msgid "Scenario:"
msgstr "시나리오:"

msgid "Game Difficulty:"
msgstr "게임 난이도:"

msgid "Opponents:"
msgstr "상대:"

msgid "Class:"
msgstr "직업:"

msgid "Rating %{rating}%"
msgstr "평가 %{rating}%"

msgid "Click here to select which scenario to play."
msgstr "클릭하여 플레이할 시나리오를 선택합니다."

msgid "Scenario"
msgstr "시나리오"

msgid "Game Difficulty"
msgstr "게임 난이도"

msgid "This lets you change the starting difficulty at which you will play. Higher difficulty levels start you off with fewer resources, and at the higher settings, give extra resources to the computer."
msgstr "시작 난이도를 변경합니다. 난이도가 높을수록 더 적은 자원으로 시작하며, 높은 난이도에서는 컴퓨터가 추가 자원을 받습니다."

msgid "Difficulty Rating"
msgstr "난이도 평가"

msgid "The difficulty rating reflects a combination of various settings for your game. This number will be applied to your final score."
msgstr "난이도 평가는 게임의 여러 설정을 종합한 수치입니다. 이 수치는 최종 점수에 반영됩니다."

msgid "Click to accept these settings and start a new game."
msgstr "클릭하여 이 설정을 적용하고 새 게임을 시작합니다."

msgid "Click to return to the main menu."
msgstr "클릭하여 주 메뉴로 돌아갑니다."

msgid "The map is corrupted or doesn't exist."
msgstr "맵이 손상되었거나 존재하지 않습니다."

msgid "Astrologers proclaim the Month of the %{name}."
msgstr "점성술사들이 %{name}의 달을 선포합니다."

msgid "New Month!"
msgstr "새로운 달!"

msgid "Astrologers proclaim the Week of the %{name}."
msgstr "점성술사들이 %{name}의 주를 선포합니다."

msgid "New Week!"
msgstr "새로운 주!"

msgid "After regular growth, the population of %{monster} is doubled!"
msgstr "일반 성장 후 %{monster}의 개체 수가 두 배가 됩니다!"

msgid "After regular growth, the population of %{monster} increases by %{count} percent!"
msgid_plural "After regular growth, the population of %{monster} increases by %{count} percent!"
msgstr[0] "일반 성장 후 %{monster}의 개체 수가 %{count}% 증가합니다!"

msgid "%{monster} growth +%{count}."
msgstr "%{monster} 성장 +%{count}."

msgid "All populations are halved."
msgstr "모든 개체 수가 절반으로 줄어듭니다."

msgid "All dwellings increase population."
msgstr "모든 거처의 개체 수가 증가합니다."

msgid "Beware!"
msgstr "주의!"

msgid "%{color} player, this is your last day to capture a town, or you will be banished from this land."
msgstr "%{color} 플레이어, 마을을 점령할 수 있는 마지막 날입니다. 오늘 안에 점령하지 못하면 이 땅에서 추방됩니다."

msgid "%{color} player, you only have %{day} days left to capture a town, or you will be banished from this land."
msgstr "%{color} 플레이어, 마을을 점령할 시간이 %{day}일밖에 남지 않았습니다. 그 안에 점령하지 못하면 이 땅에서 추방됩니다."

msgid "%{color} player's turn."
msgstr "%{color} 플레이어의 턴입니다."

msgid "%{color} player, you have lost your last town. If you do not conquer another town in the next week, you will be eliminated."
msgstr "%{color} 플레이어, 마지막 마을을 잃었습니다. 다음 일주일 안에 다른 마을을 정복하지 못하면 탈락합니다."

msgid "%{color} player, your heroes abandon you, and you are banished from this land."
msgstr "%{color} 플레이어, 영웅들이 당신을 떠났고 당신은 이 땅에서 추방되었습니다."

msgid "Lord Kilburn"
msgstr "킬번 경"

msgid "Tsabu"
msgstr "차부"

msgid "Sir Galant"
msgstr "갈란트 경"

msgid "Thundax"
msgstr "선닥스"

msgid "Lord Haart"
msgstr "하트 경"

msgid "Ariel"
msgstr "아리엘"

msgid "Rebecca"
msgstr "레베카"

msgid "Sandro"
msgstr "산드로"

msgid "Crodo"
msgstr "크로도"

msgid "Barock"
msgstr "배록"

msgid "Antoine"
msgstr "앙투안"

msgid "Astra"
msgstr "아스트라"

msgid "Agar"
msgstr "아가르"

msgid "Vatawna"
msgstr "바타우나"

msgid "Vesper"
msgstr "베스퍼"

msgid "Ambrose"
msgstr "앰브로즈"

msgid "Troyan"
msgstr "트로얀"

msgid "Jojosh"
msgstr "조조시"

msgid "Wrathmont"
msgstr "래스몬트"

msgid "Maximus"
msgstr "막시무스"

msgid "Next Hero"
msgstr "다음 영웅"

msgid "Select the next Hero."
msgstr "다음 영웅을 선택합니다."

msgid "Hero Movement"
msgstr "영웅 이동"

msgid "Start the Hero's movement along the current path or re-visit the object occupied by the Hero. Press and hold this button to reset the Hero's path."
msgstr "현재 경로를 따라 영웅의 이동을 시작하거나 영웅이 차지한 오브젝트를 다시 방문합니다. 이 버튼을 길게 누르면 영웅의 경로를 초기화합니다."

msgid "Kingdom Summary"
msgstr "왕국 요약"

msgid "View a summary of your Kingdom."
msgstr "왕국의 요약을 봅니다."

msgid "Cast an adventure spell."
msgstr "모험 주문을 시전합니다."

msgid "End Turn"
msgstr "턴 종료"

msgid "End your turn and let the computer take its turn."
msgstr "턴을 종료하고 다음 플레이어에게 차례를 넘깁니다."

msgid "Adventure Options"
msgstr "모험 옵션"

msgid "Bring up the adventure options menu."
msgstr "모험 옵션 메뉴를 엽니다."

msgid "Bring up the file options menu, allowing you to load, save, start a new game or quit."
msgstr "게임 불러오기, 저장, 새 게임 시작 또는 종료를 할 수 있는 파일 옵션 메뉴를 엽니다."

msgid "Bring up the system options menu, allowing you to customize your game."
msgstr "게임을 사용자 설정할 수 있는 시스템 옵션 메뉴를 엽니다."

msgid "Hero Movement Points"
msgstr "영웅 이동 점수"

msgid "The hero's army cannot move anymore today. The movement points will be refilled tomorrow after you end your turn."
msgstr "영웅의 군대는 오늘 더 이상 이동할 수 없습니다. 턴을 끝내면 내일 이동 점수가 회복됩니다."

msgid "One or more heroes may still move, are you sure you want to end your turn?"
msgstr "아직 이동할 수 있는 영웅이 있습니다. 정말 턴을 종료하시겠습니까?"

msgid "Are you sure you want to restart? (Your current game will be lost.)"
msgstr "정말 다시 시작하시겠습니까? (현재 게임은 사라집니다.)"

msgid "Are you sure you want to overwrite the save with this name?"
msgstr "이 이름의 저장 파일을 덮어쓰시겠습니까?"

msgid "Game saved successfully."
msgstr "게임을 저장했습니다."

msgid "Are you sure you want to load a new game? (Your current game will be lost.)"
msgstr "정말 새 게임을 불러오시겠습니까? (현재 게임은 사라집니다.)"

msgid "Try looking on land!!!"
msgstr "육지에서 찾아보세요!!!"

msgid "Searching for the Ultimate Artifact is fruitless. Your hero could not carry it even if he found it - all his artifact slots are full."
msgstr "궁극의 아티팩트를 찾아도 소용없습니다. 영웅의 아티팩트 슬롯이 가득 차 있어 발견해도 가져갈 수 없습니다."

msgid "Digging for artifacts requires a whole day, try again tomorrow."
msgstr "아티팩트를 발굴하려면 하루가 꼬박 필요합니다. 내일 다시 시도하세요."

msgid "After spending many hours digging here, you have uncovered the %{artifact}."
msgstr "여러 시간 동안 땅을 판 끝에 %{artifact}을(를) 발견했습니다."

msgid "Congratulations!"
msgstr "축하합니다!"

msgid "Nothing here. Where could it be?"
msgstr "여기에는 아무것도 없습니다. 대체 어디에 있을까요?"

msgid "Try searching on clear ground."
msgstr "평평한 땅에서 찾아보세요."

msgid "A miniature view of the known world. Left click to move viewing area."
msgstr "알려진 세계의 축소 지도입니다. 왼쪽 클릭으로 보는 영역을 이동합니다."

msgid "Month: %{month} Week: %{week}"
msgstr "월: %{month} 주: %{week}"

msgid "You find a small\nquantity of %{resource}."
msgstr "소량의\n%{resource}을(를) 발견했습니다."

msgid "Status Window"
msgstr "상태 창"

msgid "This window provides information on the status of your hero or kingdom, and shows the date."
msgstr "영웅 또는 왕국의 상태와 날짜를 보여주는 창입니다."

msgid "This window provides information on the status of your hero or kingdom, and shows the date. Left click here to cycle through these windows."
msgstr "영웅 또는 왕국의 상태와 날짜를 보여주는 창입니다. 왼쪽 클릭하면 각 상태 창을 차례로 볼 수 있습니다."

msgid "This lets you change player starting positions and colors. A particular color will always start in a particular location. Some positions may only be played by a computer player or only by a human player."
msgstr "플레이어의 시작 위치와 색상을 바꿀 수 있습니다. 각 색상은 항상 정해진 위치에서 시작합니다. 일부 위치는 컴퓨터 또는 인간 플레이어만 사용할 수 있습니다."

msgid "This lets you change the class of a player. Classes are not always changeable. Depending on the scenario, a player may receive additional towns and/or heroes not of their primary alignment."
msgstr "플레이어의 직업을 바꿀 수 있습니다. 직업은 항상 변경 가능한 것은 아닙니다. 시나리오에 따라 플레이어는 자신의 주 세력과 다른 마을이나 영웅을 추가로 받을 수 있습니다."

msgid "Handicap"
msgstr "핸디캡"

msgid "This lets you change the handicap of a particular player. Only human players may have a handicap. Handicapped players start with fewer resources and earn 15 or 30% fewer resources per turn for mild and severe handicaps, respectively."
msgstr "특정 플레이어의 핸디캡을 바꿀 수 있습니다. 핸디캡은 인간 플레이어에게만 적용할 수 있습니다. 핸디캡이 있는 플레이어는 더 적은 자원으로 시작하며, 보통 핸디캡은 턴당 자원 수입이 15%, 심한 핸디캡은 30% 감소합니다."

msgid "%{color} player"
msgstr "%{color} 플레이어"

msgid "No Handicap"
msgstr "핸디캡 없음"

msgid "No special restrictions on starting resources and resource income per turn."
msgstr "시작 자원과 턴당 자원 수입에 특별한 제한이 없습니다."

msgid "Mild Handicap"
msgstr "보통 핸디캡"

msgid "Players with mild handicap start with fewer resources and earn 15% fewer resources per turn."
msgstr "보통 핸디캡 플레이어는 더 적은 자원으로 시작하며 턴마다 얻는 자원이 15% 감소합니다."

msgid "Severe Handicap"
msgstr "심한 핸디캡"

msgid "Players with severe handicap start with fewer resources and earn 30% fewer resources per turn."
msgstr "심한 핸디캡 플레이어는 더 적은 자원으로 시작하며 턴마다 얻는 자원이 30% 감소합니다."

msgid "Default\nvalue"
msgstr "기본\n값"

msgid "Set %{skill} Skill:"
msgstr "%{skill} 기술 설정:"

msgid "Set %{skill} base value. Right-click to reset all skills to default."
msgstr "%{skill}의 기본 값을 설정합니다. 우클릭하면 모든 기술을 기본값으로 초기화합니다."

msgid "View %{skill} Info"
msgstr "%{skill} 정보 보기"

msgid "Default\nskill"
msgstr "기본\n기술"

msgid "The available values range from %{min} to %{max}."
msgstr "사용 가능한 값의 범위는 %{min}~%{max}입니다."

msgid "Uppercase"
msgstr "대문자"

msgid "Click to switch to uppercase letters."
msgstr "클릭하여 대문자로 전환합니다."

msgid "Keyboard|123"
msgstr "123"

msgid "Keyboard type"
msgstr "키보드 유형"

msgid "Click to switch between keyboard types."
msgstr "클릭하여 키보드 유형을 전환합니다."

msgid "Keyboard|SPACE"
msgstr "스페이스"

msgid "Change language"
msgstr "언어 변경"

msgid "Click to switch between languages."
msgstr "클릭하여 언어를 전환합니다."

msgid "Backspace"
msgstr "백스페이스"

msgid "Click to remove characters."
msgstr "클릭하여 문자를 지웁니다."

msgid "Lowercase"
msgstr "소문자"

msgid "Click to switch to lowercase letters."
msgstr "클릭하여 소문자로 전환합니다."

msgid "Keyboard|ABC"
msgstr "ABC"

msgid "Swap sign"
msgstr "부호 전환"

msgid "Click to switch between signed and unsigned numbers."
msgstr "클릭하여 양수와 음수 사이를 전환합니다."

msgid "The entered value is invalid."
msgstr "입력한 값이 올바르지 않습니다."

msgid "The entered value is out of range.\nIt should be not less than %{minValue} and not more than %{maxValue}."
msgstr "입력한 값이 범위를 벗어났습니다.\n%{minValue} 이상 %{maxValue} 이하여야 합니다."

msgid "Kingdom Income"
msgstr "왕국 수입"

msgid "Kingdom Income per day."
msgstr "왕국의 하루 수입입니다."

msgid "For every lighthouse controlled, your ships will move further each day."
msgstr "보유한 등대 하나마다 함선이 하루에 더 멀리 이동할 수 있습니다."

