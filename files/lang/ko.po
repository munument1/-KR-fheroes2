msgstr "%{name}은(는) 어떤 주문의 영향도 받지 않습니다."

msgid "The %{name} cannot be resurrected."
msgstr "%{name}은(는) 부활시킬 수 없습니다."

msgid "The %{name} has no dead creatures to resurrect."
msgstr "%{name}에는 부활시킬 죽은 생물이 없습니다."

msgid "The %{name} has been resurrected."
msgstr "%{name}이(가) 부활했습니다."

msgid "The %{name} can no longer be resurrected."
msgstr "%{name}은(는) 더 이상 부활시킬 수 없습니다."

