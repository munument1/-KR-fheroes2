msgid "%{skill} reduces the movement penalty for rough terrain by %{count} percent."
msgstr "%{skill}은(는) 험지 이동 페널티를 %{count}% 줄입니다."

msgid "%{skill} eliminates the movement penalty for rough terrain."
msgstr "%{skill}은(는) 험지 이동 페널티를 없앱니다."

msgid "%{skill} increases the damage done by the hero's range attacking creatures by %{count} percent, and eliminates the %{penalty} percent penalty when shooting past obstacles (e.g. castle walls)."
msgstr "%{skill}은(는) 영웅의 원거리 공격 생물이 주는 피해를 %{count}% 늘리고, 장애물(예: 성벽) 너머로 사격할 때 받는 %{penalty}% 페널티를 없앱니다."

msgid "%{skill} increases the hero's movement points by %{count} percent."
msgstr "%{skill}은(는) 영웅의 이동 점수를 %{count}% 늘립니다."

msgid "%{skill} increases the hero's viewable area by one square."
msgid_plural "%{skill} increases the hero's viewable area by %{count} squares."
msgstr[0] "%{skill}은(는) 영웅이 볼 수 있는 범위를 %{count}칸 넓힙니다."

msgid "%{skill} allows the hero to negotiate with monsters who are weaker than their army, and reduces the cost of surrender."
msgstr "%{skill}은(는) 자신의 군대보다 약한 몬스터와 협상할 수 있게 하고 항복 비용을 줄입니다."

msgid "Approximately %{count} percent of the creatures may offer to join the hero."
msgstr "생물 중 약 %{count}%가 영웅에게 합류를 제안할 수 있습니다."

msgid "All of the creatures may offer to join the hero."
msgstr "모든 생물이 영웅에게 합류를 제안할 수 있습니다."

msgid "The cost of surrender is reduced to %{percent} percent of the total cost of troops in the army."
msgstr "항복 비용이 군대 전체 병력 가격의 %{percent}%로 감소합니다."

msgid "%{skill} increases the hero's movement points over water by %{count} percent."
msgstr "%{skill}은(는) 영웅의 수상 이동 점수를 %{count}% 늘립니다."

msgid "%{skill} increases the hero's troops morale by %{count}."
msgstr "%{skill}은(는) 영웅 부대의 사기를 %{count} 높입니다."

msgid "%{skill} allows the hero to learn third level spells."
msgstr "%{skill}은(는) 영웅이 3레벨 주문을 배울 수 있게 합니다."

msgid "%{skill} allows the hero to learn fourth level spells."
msgstr "%{skill}은(는) 영웅이 4레벨 주문을 배울 수 있게 합니다."

msgid "%{skill} allows the hero to learn fifth level spells."
msgstr "%{skill}은(는) 영웅이 5레벨 주문을 배울 수 있게 합니다."

msgid "%{skill} regenerates one additional spell point per day to the hero."
msgid_plural "%{skill} regenerates %{count} additional spell points per day to the hero."
msgstr[0] "%{skill}은(는) 영웅의 주문 점수를 매일 %{count} 추가로 회복합니다."

msgid "%{skill} increases the hero's luck by %{count}."
msgstr "%{skill}은(는) 영웅의 행운을 %{count} 높입니다."

msgid "%{skill} gives the hero's catapult shots a greater chance to hit and do damage to castle walls."
msgstr "%{skill}은(는) 영웅의 투석기 공격이 성벽을 명중하고 피해를 줄 확률을 높입니다."

msgid "%{skill} gives the hero's catapult an extra shot, and each shot has a greater chance to hit and do damage to castle walls."
msgstr "%{skill}은(는) 영웅의 투석기에 추가 사격 1회를 주며, 각 사격이 성벽을 명중하고 피해를 줄 확률을 높입니다."

msgid "%{skill} gives the hero's catapult an extra shot, and each shot automatically destroys any wall, except a fortified wall in a Knight castle."
msgstr "%{skill}은(는) 영웅의 투석기에 추가 사격 1회를 주며, 기사의 성에 있는 강화 성벽을 제외한 모든 성벽을 각 사격으로 자동 파괴합니다."

msgid "%{skill} gives the hero a %{count} percent chance to learn any given 1st or 2nd level spell that was cast by an enemy during combat."
msgstr "%{skill}은(는) 전투 중 적이 시전한 1~2레벨 주문을 영웅이 배울 확률을 %{count}% 부여합니다."

msgid "%{skill} gives the hero a %{count} percent chance to learn any given 3rd level spell (or below) that was cast by an enemy during combat."
msgstr "%{skill}은(는) 전투 중 적이 시전한 3레벨 이하 주문을 영웅이 배울 확률을 %{count}% 부여합니다."

msgid "%{skill} gives the hero a %{count} percent chance to learn any given 4th level spell (or below) that was cast by an enemy during combat."
msgstr "%{skill}은(는) 전투 중 적이 시전한 4레벨 이하 주문을 영웅이 배울 확률을 %{count}% 부여합니다."

msgid "%{skill} allows %{count} percent of the creatures killed in combat to be brought back from the dead as Skeletons."
msgstr "%{skill}은(는) 전투에서 죽은 생물의 %{count}%를 해골로 되살릴 수 있게 합니다."

msgid "The hero produces %{count} gold pieces per day as tax revenue from estates."
msgstr "영웅은 영지에서 세금으로 매일 %{count}골드를 생산합니다."

