msgstr "%{name2}과(와) %{name} 교환"

msgid "Select %{name}"
msgstr "%{name} 선택"

msgid "Cannot move last troop"
msgstr "마지막 부대는 이동할 수 없습니다"

msgid "Set %{monster} Count:"
msgstr "%{monster} 수 설정:"

msgid "%{name} destroys half the enemy troops!"
msgid_plural "%{name} destroy half the enemy troops!"
msgstr[0] "%{name}의 공격으로 적 병력의 절반이 파괴됩니다!"

msgid "%{name} has turned off the auto combat"
msgstr "%{name}: 자동 전투를 끔"

msgid "%{name} has turned on the auto combat"
msgstr "%{name}: 자동 전투를 켬"

msgid "Spell failed!"
msgstr "주문 실패!"

msgid "The Sphere of Negation artifact is in effect for this battle, disabling all combat spells."
msgstr "무효화의 구체 아티팩트가 이 전투에 영향을 미쳐 모든 전투 주문을 사용할 수 없습니다."

msgid "You cannot cast spells without a commanding hero."
msgstr "지휘하는 영웅이 없으면 주문을 시전할 수 없습니다."

msgid "You have already cast a spell this round."
msgstr "이번 라운드에는 이미 주문을 시전했습니다."

msgid "That spell will have no effect!"
msgstr "그 주문은 효과가 없습니다!"

msgid "You may only summon one type of elemental per combat."
msgstr "한 전투에서는 한 종류의 정령만 소환할 수 있습니다."

msgid "There is no open space adjacent to your hero where you can summon an Elemental to."
msgstr "영웅 주변에 정령을 소환할 빈 공간이 없습니다."

msgid "The Moat interrupts any movement through it and reduces the defense skill of troops present in it by %{count}."
msgstr "해자는 통과하는 모든 이동을 중단시키며, 해자 안에 있는 부대의 방어력을 %{count}만큼 낮춥니다."

msgid "battleAnimation|Speed: %{speed}"
msgstr "속도: %{speed}"

msgid "battleAnimation|Speed"
msgstr "속도"

msgid "Interface"
msgstr "인터페이스"

msgid "Settings"
msgstr "설정"

msgid "Auto Spell Casting"
msgstr "자동 주문 시전"

msgid "Off"
msgstr "끔"

msgid "On"
msgstr "켬"

msgid "Set the speed of combat actions and animations."
msgstr "전투 행동과 애니메이션 속도를 설정합니다."

msgid "Change the interface settings of the game."
msgstr "게임의 인터페이스 설정을 변경합니다."

msgid "Interface Settings"
msgstr "인터페이스 설정"

msgid "Toggle whether or not the computer will cast spells for you when auto combat is on. (Note: This does not affect spell casting for computer players in any way, nor does it affect quick combat.)"
msgstr "자동 전투 중 컴퓨터가 대신 주문을 시전할지 설정합니다. (참고: 컴퓨터 플레이어의 주문 시전이나 빠른 전투에는 영향을 주지 않습니다.)"

msgid "Audio"
msgstr "오디오"

msgid "Change the audio settings of the game."
msgstr "게임의 오디오 설정을 변경합니다."

msgid "Check and configure all the hot keys present in the game."
msgstr "게임의 모든 단축키를 확인하고 설정합니다."

msgid "Hot Keys"
msgstr "단축키"

msgid "Exit this menu."
msgstr "이 메뉴를 닫습니다."

msgid "Okay"
msgstr "확인"

msgid "The enemy has surrendered!"
msgstr "적이 항복했습니다!"

msgid "Their cowardice costs them %{gold} gold."
msgstr "적의 비겁함으로 %{gold}골드를 얻었습니다."

msgid "The enemy has fled!"
msgstr "적이 도망쳤습니다!"

msgid "A glorious victory!"
msgstr "영광스러운 승리!"

msgid "For valor in combat, %{name} receives %{exp} experience."
msgstr "전투에서 용맹을 떨친 %{name}은(는) 경험치 %{exp}을(를) 얻습니다."

msgid "The cowardly %{name} flees from battle."
msgstr "겁에 질린 %{name}이(가) 전투에서 도망칩니다."

msgid "%{name} surrenders to the enemy, and departs in shame."
msgstr "%{name}이(가) 적에게 항복하고 수치 속에 떠납니다."

msgid "Your forces suffer a bitter defeat, and %{name} abandons your cause."
msgstr "아군은 쓰라린 패배를 당했고, %{name}이(가) 당신의 편을 떠납니다."

msgid "Your forces suffer a bitter defeat."
msgstr "아군은 쓰라린 패배를 당했습니다."

msgid "Battlefield Casualties"
msgstr "전장 사상자"

msgid "Attacker"
msgstr "공격자"

msgid "Defender"
msgstr "방어자"

msgid "Click to leave the battle results."
msgstr "전투 결과를 닫으려면 클릭하세요."

msgid "Click to restart the battle in manual mode."
msgstr "수동 모드로 전투를 다시 시작하려면 클릭하세요."

msgid "Restart"
msgstr "다시 시작"

msgid "You have captured an enemy artifact!"
msgstr "적의 아티팩트를 노획했습니다!"

msgid "As you reach for the %{name}, it mysteriously disappears."
msgstr "%{name}에 손을 뻗는 순간, 그것이 수수께끼처럼 사라집니다."

msgid "As your enemy reaches for the %{name}, it mysteriously disappears."
msgstr "적이 %{name}에 손을 뻗는 순간, 그것이 수수께끼처럼 사라집니다."

msgid "Necromancy!"
msgstr "강령술!"

msgid "Practicing the dark arts of necromancy, you are able to raise %{count} of the enemy's dead to return under your service as %{monster}."
msgstr "어둠의 강령술을 행해 적의 전사자 %{count}명을 %{monster}(으)로 되살려 당신을 섬기게 합니다."

msgid "%{name} the %{race}"
msgstr "%{race} %{name}"

msgid "Captain of %{name}"
msgstr "%{name}의 대장"

msgid "Attack"
msgstr "공격"

msgid "Defense"
msgstr "방어"

msgid "Spell Power"
msgstr "주문력"

msgid "Knowledge"
msgstr "지식"

msgid "Morale"
msgstr "사기"

msgid "Luck"
msgstr "행운"

msgid "Spell Points"
msgstr "주문 점수"

msgid "Cast Spell"
msgstr "주문 시전"

msgid "Retreat"
msgstr "퇴각"

msgid "Surrender"
msgstr "항복"

msgid "Cancel"
msgstr "취소"

msgid "Hero Screen"
msgstr "영웅 화면"

msgid "Captain's Options"
msgstr "대장 옵션"

msgid "Hero's Options"
msgstr "영웅 옵션"

msgid "Cast a magical spell. You may only cast one spell per combat round. The round is reset when every creature has had a turn."
msgstr "마법 주문을 시전합니다. 전투 라운드마다 한 번만 주문을 시전할 수 있으며, 모든 생물이 한 번씩 행동하면 새 라운드가 시작됩니다."

msgid "Retreat your hero, abandoning your creatures. Your hero will be available for you to recruit again, however, the hero will have only a novice hero's forces."
msgstr "영웅이 부대를 버리고 퇴각합니다. 해당 영웅은 다시 고용할 수 있지만, 초보 영웅 수준의 병력만 거느리게 됩니다."

msgid "Surrendering costs gold. However if you pay the ransom, the hero and all of his or her surviving creatures will be available to recruit again. The cost of surrender is half of the total cost of the non-temporary troops remaining in the army."
msgstr "항복에는 골드가 필요합니다. 몸값을 지불하면 영웅과 살아남은 모든 부대를 다시 고용할 수 있습니다. 항복 비용은 군대에 남은 비임시 병력 총 고용비의 절반입니다."

msgid "Open Hero Screen to view full information about the hero."
msgstr "영웅 화면을 열어 영웅의 전체 정보를 확인합니다."

msgid "Return to the battle."
msgstr "전투로 돌아갑니다."

msgid "Not enough gold (%{gold})"
msgstr "골드 부족 (%{gold})"

msgid "%{name} states:"
msgstr "%{name}의 제안:"

msgid "Captain of %{name} states:"
msgstr "%{name}의 대장이 제안합니다:"

msgid "\"I will accept your surrender and grant you and your troops safe passage for the price of %{price} gold.\""
msgstr "\"%{price}골드를 내면 항복을 받아들이고 너와 네 부대의 안전한 통행을 보장하겠다.\""

msgid "View %{monster} info"
msgstr "%{monster} 정보 보기"

msgid "Fly %{monster} here"
msgstr "%{monster} 여기로 비행"

msgid "Move %{monster} here"
msgstr "%{monster} 여기로 이동"

msgid "Shoot %{monster}"
msgstr "%{monster} 사격"

msgid "(1 shot left)"
msgid_plural "(%{count} shots left)"
msgstr[0] "남은 사격 횟수: %{count}"

msgid "Attack %{monster}"
msgstr "%{monster} 공격"

msgid "Turn %{turn}"
msgstr "%{turn}턴"

msgid "Teleport here"
msgstr "여기로 순간이동"

msgid "Invalid teleport destination"
msgstr "순간이동할 수 없는 위치입니다"

msgid "Cast %{spell} on %{monster}"
msgstr "%{monster}에게 %{spell} 시전"

msgid "Cast %{spell}"
msgstr "%{spell} 시전"

msgid "Select spell target"
msgstr "주문 대상을 선택하세요"

msgid "Are you sure you want to enable the auto combat mode?"
msgstr "자동 전투 모드를 켜시겠습니까?"

msgid "Are you sure you want to resolve the battle in the quick combat mode?"
msgstr "빠른 전투 모드로 전투를 해결하시겠습니까?"

msgid "View Ballista info"
msgstr "발리스타 정보 보기"

msgid "Ballista"
msgstr "발리스타"

msgid "Automatic combat modes"
msgstr "자동 전투 모드"

msgid "Automatic Combat Modes"
msgstr "자동 전투 모드"

msgid "Choose between proceeding the combat in auto combat mode or in quick combat mode."
msgstr "자동 전투와 빠른 전투 중 진행 방식을 선택합니다."

msgid "Customize system options"
msgstr "시스템 옵션 설정"

msgid "Allows you to customize the combat screen."
msgstr "전투 화면을 사용자 설정할 수 있습니다."

msgid "System Options"
msgstr "시스템 옵션"

msgid "Skip this unit"
msgstr "이 유닛의 턴 넘기기"

msgid "Skip"
msgstr "넘기기"

msgid "Skips the current creature. The current creature ends its turn and does not get to go again until the next round."
msgstr "현재 생물의 턴을 넘깁니다. 이 생물은 턴을 종료하며 다음 라운드가 될 때까지 다시 행동할 수 없습니다."

msgid "View Captain's options"
msgstr "대장 옵션 보기"

msgid "View Hero's options"
msgstr "영웅 옵션 보기"

msgid "View opposing Captain"
msgstr "상대 대장 보기"

msgid "View opposing Hero"
msgstr "상대 영웅 보기"

msgid "Hide logs"
msgstr "기록 숨기기"

msgid "Show logs"
msgstr "기록 표시"

msgid "Message Bar"
msgstr "메시지 바"

msgid "Shows the results of individual monster's actions."
msgstr "각 몬스터의 행동 결과를 표시합니다."

msgid "AUTO\nCOMBAT"
msgstr "자동\n전투"

msgid "QUICK\nCOMBAT"
msgstr "빠른\n전투"

msgid "The computer continues the combat for you."
msgstr "컴퓨터가 대신 전투를 계속합니다."

msgid "autoCombat|This can be interrupted at any moment by pressing the Auto Combat hotkey or the default Cancel key, or by performing a left or right click anywhere on the game screen."
msgstr "자동 전투 단축키나 기본 취소 키를 누르거나, 게임 화면 어디서든 좌클릭 또는 우클릭하면 언제든 중단할 수 있습니다."

msgid "Auto Combat"
msgstr "자동 전투"

msgid "The combat is resolved from the current state."
msgstr "현재 상태에서 전투 결과를 즉시 계산합니다."

msgid "quickCombat|This cannot be undone."
msgstr "이 작업은 되돌릴 수 없습니다."

msgid "Quick Combat"
msgstr "빠른 전투"

msgid "The %{name} skips their turn."
msgid_plural "The %{name} skip their turn."
msgstr[0] "%{name}: 턴을 넘깁니다."

msgid "%{attacker} does %{damage} damage."
msgid_plural "%{attacker} do %{damage} damage."
msgstr[0] "%{attacker}: %{damage}의 피해를 줍니다."

msgid "1 creature perishes."
msgid_plural "%{count} creatures perish."
msgstr[0] "%{count}명이 쓰러집니다."

msgid "1 %{defender} perishes."
msgid_plural "%{count} %{defender} perish."
msgstr[0] "%{defender} %{count}명이 쓰러집니다."

msgid "1 soul is incorporated."
msgid_plural "%{count} souls are incorporated."
msgstr[0] "영혼 %{count}개를 흡수했습니다."

msgid "1 %{unit} is revived."
msgid_plural "%{count} %{unit} are revived."
msgstr[0] "%{unit} %{count}명이 부활합니다."

msgid "Moved %{monster}: from [%{src}] to [%{dst}]."
msgstr "%{monster}: [%{src}]에서 [%{dst}](으)로 이동."

msgid "The %{name} resists the spell!"
msgid_plural "The %{name} resist the spell!"
msgstr[0] "%{name}: 주문을 저항합니다!"

msgid "%{name} casts %{spell} on the %{troop}."
msgstr "%{name}: %{troop}에게 %{spell} 시전."

msgid "%{name} casts %{spell}."
msgstr "%{name}: %{spell} 시전."

msgid "The %{spell} does %{damage} damage to one undead creature."
msgstr "%{spell}이(가) 언데드 하나에게 %{damage}의 피해를 줍니다."

msgid "The %{spell} does %{damage} damage to all undead creatures."
msgstr "%{spell}이(가) 모든 언데드에게 %{damage}의 피해를 줍니다."

msgid "The %{spell} does %{damage} damage, %{count} creatures perish."
msgstr "%{spell}이(가) %{damage}의 피해를 주어 %{count}명이 쓰러집니다."

msgid "The %{spell} does %{damage} damage."
msgstr "%{spell}이(가) %{damage}의 피해를 줍니다."

msgid "The %{spell} does %{damage} damage to one living creature."
msgstr "%{spell}이(가) 살아 있는 생물 하나에게 %{damage}의 피해를 줍니다."

msgid "The %{spell} does %{damage} damage to all living creatures."
msgstr "%{spell}이(가) 살아 있는 모든 생물에게 %{damage}의 피해를 줍니다."

msgid "The %{attacker}'s attack blinds the %{target}!"
msgid_plural "The %{attacker}' attack blinds the %{target}!"
msgstr[0] "%{attacker}의 공격으로 %{target}이(가) 실명합니다!"

msgid "The %{attacker}'s gaze turns the %{target} to stone!"
msgid_plural "The %{attacker}' gaze turns the %{target} to stone!"
msgstr[0] "%{attacker}의 시선으로 %{target}이(가) 돌로 변합니다!"

msgid "The %{attacker}'s curse falls upon the %{target}!"
msgid_plural "The %{attacker}' curse falls upon the %{target}!"
msgstr[0] "%{attacker}의 저주가 %{target}에게 내립니다!"

msgid "The %{target} is paralyzed by the %{attacker}!"
msgid_plural "The %{target} are paralyzed by the %{attacker}!"
msgstr[0] "%{target}이(가) %{attacker}에게 마비됩니다!"

msgid "The %{attacker} dispels all good spells on your %{target}!"
msgid_plural "The %{attacker} dispel all good spells on your %{target}!"
msgstr[0] "%{attacker}이(가) 아군 %{target}에게 걸린 모든 이로운 주문을 해제합니다!"

msgid "The %{attacker} casts %{spell} on the %{target}!"
msgid_plural "The %{attacker} cast %{spell} on the %{target}!"
msgstr[0] "%{attacker}이(가) %{target}에게 %{spell}을(를) 시전합니다!"

msgid "Bad luck descends on the %{attacker}."
msgstr "%{attacker}에게 불운이 닥칩니다."

msgid "Good luck shines on the %{attacker}."
msgstr "%{attacker}에게 행운이 비칩니다."

msgid "High morale enables the %{monster} to attack again."
msgstr "높은 사기로 %{monster}이(가) 다시 공격합니다."

msgid "Low morale causes the %{monster} to freeze in panic."
msgstr "낮은 사기로 %{monster}이(가) 공포에 얼어붙습니다."

msgid "%{tower} does %{damage} damage."
msgstr "%{tower}: %{damage}의 피해."

msgid "The mirror image is created."
msgstr "분신이 생성되었습니다."

msgid "The mirror image is destroyed!"
msgstr "분신이 파괴되었습니다!"

msgid "Are you sure you want to interrupt the auto combat mode?"
msgstr "자동 전투 모드를 중단하시겠습니까?"

msgid "Error"
msgstr "오류"

msgid "No spells to cast."
msgstr "시전할 주문이 없습니다."

msgid "Are you sure you want to retreat?"
msgstr "퇴각하시겠습니까?"

msgid "Retreat disabled"
msgstr "퇴각 불가"

msgid "Surrender disabled"
msgstr "항복 불가"

msgid "Damage: %{max}"
msgstr "피해: %{max}"

msgid "Damage: %{min} - %{max}"
msgstr "피해: %{min} - %{max}"

msgid "Perish: %{max}"
msgstr "사망: %{max}"

msgid "Perish: %{min} - %{max}"
msgstr "사망: %{min} - %{max}"

msgid "battle_turn_order|Top"
msgstr "위"

msgid "battle_turn_order|Bottom"
msgstr "아래"

msgid "Turn Order"
msgstr "행동 순서"

msgid "Grid"
msgstr "격자"

msgid "Damage Info"
msgstr "피해 정보"

msgid "Shadow Movement"
msgstr "이동 영역 음영"

msgid "Shadow Cursor"
msgstr "커서 음영"

msgid "Movement Area"
msgstr "이동 가능 영역"

msgid "Toggle to display the turn order during the battle."
msgstr "전투 중 행동 순서를 표시할지 설정합니다."

msgid "Toggle the hex grid on or off. The hex grid always underlies movement, even if turned off. This switch only determines if the grid is visible."
msgstr "육각 격자를 표시하거나 숨깁니다. 격자를 숨겨도 이동은 항상 육각 격자를 기준으로 하며, 이 설정은 표시 여부에만 영향을 줍니다."

msgid "Toggle to display damage information during the battle."
msgstr "전투 중 피해 정보를 표시할지 설정합니다."

msgid "Toggle on or off shadows showing where your creatures can move and attack."
msgstr "생물이 이동하거나 공격할 수 있는 위치를 나타내는 음영을 표시할지 설정합니다."

msgid "Toggle on or off a shadow showing the current hex location of the mouse cursor."
msgstr "마우스 커서가 가리키는 현재 육각 칸에 음영을 표시할지 설정합니다."

msgid "Toggle showing the movement area of a highlighted creature on or off."
msgstr "선택한 생물의 이동 가능 영역을 표시할지 설정합니다."

msgid "Through eagle-eyed observation, %{name} is able to learn the magic spell %{spell}."
msgstr "예리한 관찰력으로 %{name}이(가) 마법 주문 %{spell}을(를) 배웠습니다."

msgid "Human"
msgstr "인간"

msgid "Terrain"
msgstr "지형"

msgid "Battle Only"
msgstr "전투 전용"

msgid "Start"
msgstr "시작"

msgid "Start the battle."
msgstr "전투를 시작합니다."

msgid "Exit"
msgstr "나가기"

msgid "Reset"
msgstr "초기화"

msgid "Reset to default settings."
msgstr "기본 설정으로 초기화합니다."

msgid "The battle will take place on a randomly selected terrain. Click to change the terrain type."
msgstr "전투는 무작위 지형에서 진행됩니다. 클릭하여 지형 유형을 변경하세요."

msgid "The battle will take place on %{terrain-type} terrain. Click to change the terrain type."
msgstr "전투는 %{terrain-type} 지형에서 진행됩니다. 클릭하여 지형 유형을 변경하세요."

msgid "Please select another hero."
msgstr "다른 영웅을 선택하세요."

msgid "Click to select a hero."
msgstr "클릭하여 영웅을 선택하세요."

msgid "Hero"
msgstr "영웅"

msgid "If this checkbox is checked, the defending hero is going be human-controlled."
msgstr "이 항목을 선택하면 방어 측 영웅을 사람이 조종합니다."

msgid "%{race1} %{name1} vs %{race2} %{name2}"
msgstr "%{race1} %{name1} 대 %{race2} %{name2}"

msgid "Monsters"
msgstr "몬스터"

msgid "N/A"
msgstr "해당 없음"

msgid "Left Turret"
msgstr "왼쪽 포탑"

msgid "Right Turret"
msgstr "오른쪽 포탑"

msgid "The %{name} fires with the strength of %{count} Archers"
msgstr "%{name}은(는) 궁수 %{count}명에 해당하는 위력으로 사격합니다"

msgid "each with a +%{attack} bonus to their attack skill."
msgstr "각각 공격력에 +%{attack} 보너스를 받습니다."

msgid "The %{name} is destroyed."
msgstr "%{name}이(가) 파괴되었습니다."

msgid "%{count} %{name} rises from the dead!"
msgid_plural "%{count} %{name} rise from the dead!"
msgstr[0] "%{name} %{count}명이 죽음에서 일어납니다!"

msgid "Dwarven Alliance"
msgstr "드워프 동맹"

msgid "Sorceress Guild"
msgstr "소서리스 길드"

msgid "Necromancer Guild"
msgstr "네크로맨서 길드"

msgid "Ogre Alliance"
msgstr "오우거 동맹"

msgid "Dwarfbane"
msgstr "드워프베인"

msgid "Dragon Alliance"
msgstr "드래곤 동맹"

msgid "Elven Alliance"
msgstr "엘프 동맹"

msgid "Kraeger defeated"
msgstr "크레이거 격파"

msgid "Wayward Son"
msgstr "방황하는 아들"

msgid "Uncle Ivan"
msgstr "이반 삼촌"

msgid "Annexation"
msgstr "병합"

msgid "Force of Arms"
msgstr "무력 행사"

msgid "Save the Dwarves"
msgstr "드워프 구출"

msgid "Carator Mines"
msgstr "카라토르 광산"

msgid "Turning Point"
msgstr "전환점"

msgid "scenarioName|Defender"
msgstr "수호자"

msgid "Corlagon's Defense"
msgstr "콜라곤의 방어"

msgid "The Crown"
msgstr "왕관"

msgid "The Gauntlet"
msgstr "시련"

msgid "Betrayal"
msgstr "배신"

msgid "Final Justice"
msgstr "최후의 심판"

msgid "Roland needs you to defeat the lords near his castle to begin his war of rebellion against his brother. They are not allied with each other, so they will spend most of their time fighting with one another. Victory is yours when you have defeated all of their castles and heroes."
msgstr "롤랜드는 형제에 맞선 반란 전쟁을 시작하기 위해 성 주변의 영주들을 물리쳐 달라고 합니다. 그들은 서로 동맹이 아니므로 대부분 서로 싸우느라 힘을 소모할 것입니다. 모든 성과 영웅을 격파하면 승리합니다."

msgid "The local lords refuse to swear allegiance to Roland, and must be subdued. They are wealthy and powerful, so be prepared for a tough fight. Capture all enemy castles to win."
msgstr "지역 영주들은 롤랜드에게 충성을 맹세하기를 거부했습니다. 부유하고 강대한 자들이니 힘겨운 싸움에 대비하세요. 모든 적의 성을 점령하면 승리합니다."

msgid "Your task is to defend the Dwarves against Archibald's forces. Capture all of the enemy towns and castles to win, and be sure not to lose all of the dwarf towns at once, or the enemy will have won."
msgstr "아치볼드의 군대로부터 드워프들을 지켜야 합니다. 모든 적의 마을과 성을 점령하면 승리합니다. 드워프 마을을 한꺼번에 모두 잃으면 패배하니 주의하세요."

msgid "You will face four allied enemies in a straightforward fight for resources and treasure. Capture all of the enemy castles for victory."
msgstr "네 명의 적이 동맹을 맺고 자원과 보물을 두고 맞섭니다. 모든 적의 성을 점령하면 승리합니다."

msgid "Your enemies are allied against you and start close by, so be ready to come out fighting. You will need to own all four castles in this small valley to win."
msgstr "적들은 모두 동맹을 맺고 가까이에서 시작합니다. 즉시 전투에 나설 준비를 하세요. 이 작은 계곡의 성 네 곳을 모두 차지해야 승리합니다."

msgid "The Sorceress' guild of Noraston has requested Roland's aid against an attack from Archibald's allies. Capture all of the enemy castles to win, and don't lose Noraston, or you'll lose the scenario. (Hint: There is an enemy castle on an island in the ocean.)"
msgstr "노라스턴의 소서리스 길드가 아치볼드의 동맹군 공격을 막아 달라며 롤랜드에게 도움을 요청했습니다. 모든 적의 성을 점령하면 승리하지만, 노라스턴을 잃으면 시나리오에서 패배합니다. (힌트: 바다의 섬 하나에 적의 성이 있습니다.)"

msgid "Gather as large an army as possible and capture the enemy castle within 8 weeks. You are opposed by only one enemy, but must travel a long way to get to the enemy castle. Any troops you have in your army at the end of this scenario will be with you in the final battle."
msgstr "가능한 한 큰 군대를 모아 8주 안에 적의 성을 점령하세요. 적은 하나뿐이지만 적의 성까지는 먼 길을 가야 합니다. 이 시나리오가 끝날 때 군대에 남아 있는 병력은 최종 전투에도 함께합니다."

msgid "Find the Crown before Archibald's heroes find it. Roland will need the Crown for the final battle against Archibald."
msgstr "아치볼드의 영웅들보다 먼저 왕관을 찾으세요. 롤랜드는 아치볼드와의 최종 전투에 왕관이 필요합니다."

msgid "Three allied enemies stand before you and victory, including Lord Corlagon. Roland is in a castle to the northwest, and you will lose if he falls to the enemy. Remember that capturing Lord Corlagon will ensure that he will not fight against you in the final scenario."
msgstr "콜라곤 경을 포함한 세 적이 동맹을 맺고 당신을 가로막습니다. 롤랜드는 북서쪽 성에 있으며, 그가 적에게 쓰러지면 패배합니다. 콜라곤 경을 사로잡으면 최종 시나리오에서 그가 적으로 나오지 않습니다."

msgid "This is the final battle. Both you and your enemy are armed to the teeth, and all are allied against you. Capture Archibald to end the war!"
msgstr "최종 전투입니다. 양측 모두 완전 무장했으며 모든 적이 당신에 맞서 동맹을 맺었습니다. 아치볼드를 사로잡아 전쟁을 끝내세요!"

msgid "Switching sides leaves you with three castles against the enemy's one. This battle will be the easiest one you will face for the rest of the war...traitor."
msgstr "편을 바꾸면 적의 성 하나에 맞서 성 세 곳을 갖고 시작합니다. 남은 전쟁에서 가장 쉬운 전투가 될 것입니다... 배신자."

msgid "Barbarian Wars"
msgstr "야만인 전쟁"

msgid "First Blood"
msgstr "첫 피"

msgid "Necromancers"
msgstr "네크로맨서"

msgid "Slay the Dwarves"
msgstr "드워프 처단"

msgid "Country Lords"
msgstr "지방 영주"

msgid "Dragon Master"
msgstr "드래곤 마스터"

msgid "Rebellion"
msgstr "반란"

msgid "Apocalypse"
msgstr "종말"

msgid "Greater Glory"
msgstr "더 큰 영광"

msgid "King Archibald requires you to defeat the three enemies in this region. They are not allied with one another, so they will spend most of their energy fighting amongst themselves. You will win when you own all of the enemy castles and there are no more heroes left to fight."
msgstr "아치볼드 왕은 이 지역의 세 적을 물리치라고 명령했습니다. 적들은 서로 동맹이 아니므로 대부분의 힘을 서로 싸우는 데 쓸 것입니다. 모든 적의 성을 차지하고 싸울 영웅이 더 이상 남지 않으면 승리합니다."

msgid "You must unify the barbarian tribes of the north by conquering them. As in the previous mission, the enemy is not allied against you, but they have more resources at their disposal. You will win when you own all of the enemy castles and there are no more heroes left to fight."
msgstr "북부의 야만인 부족을 정복해 하나로 통합해야 합니다. 이전 임무와 마찬가지로 적들은 서로 동맹이 아니지만 더 많은 자원을 보유하고 있습니다. 모든 적의 성을 차지하고 싸울 영웅이 더 이상 남지 않으면 승리합니다."

msgid "Do-gooder wizards have taken the Necromancers' castle. You must retake it to achieve victory. Remember that while you start with a powerful army, you have no castle and must take one within 7 days, or lose this battle. (Hint: The nearest castle is to the southeast.)"
msgstr "선행을 자처하는 마법사들이 네크로맨서의 성을 빼앗았습니다. 승리하려면 성을 되찾아야 합니다. 강력한 군대로 시작하지만 성이 없으므로 7일 안에 성 하나를 점령하지 못하면 패배합니다. (힌트: 가장 가까운 성은 남동쪽에 있습니다.)"

msgid "The dwarves need conquering before they can interfere in King Archibald's plans. Roland's forces have more than one hero and many towns to start with, so be ready for attack from multiple directions. You must capture all of the enemy towns and castles to claim victory."
msgstr "드워프들이 아치볼드 왕의 계획에 끼어들기 전에 정복해야 합니다. 롤랜드의 군대는 여러 영웅과 많은 마을을 보유하고 있어 여러 방향에서 공격해 올 수 있습니다. 모든 적의 마을과 성을 점령하면 승리합니다."

msgid "You must put down a peasant revolt led by Roland's forces. All are allied against you, but you have Lord Corlagon, an experienced hero, to help you. Capture all enemy castles to win."
msgstr "롤랜드의 군대가 이끄는 농민 반란을 진압해야 합니다. 적들은 모두 동맹을 맺었지만, 노련한 영웅 콜라곤 경이 당신을 돕습니다. 모든 적의 성을 점령하면 승리합니다."

msgid "There are two enemies allied against you in this mission. Both are well armed and seek to evict you from their island. Avoid them and capture Dragon City to win."
msgstr "이번 임무에서는 두 적이 동맹을 맺고 당신에 맞섭니다. 둘 다 강하게 무장했으며 섬에서 당신을 몰아내려 합니다. 정면충돌을 피하고 드래곤 시티를 점령하면 승리합니다."

msgid "Your orders are to conquer the country lords that have sworn to serve Roland. All of the enemy castles are unified against you. Since you start without a castle, you must hurry to capture one before the end of the week. Capture all enemy castles for victory."
msgstr "롤랜드에게 충성을 맹세한 지방 영주들을 정복하라는 명령을 받았습니다. 모든 적의 성이 연합해 당신에 맞섭니다. 성 없이 시작하므로 한 주가 끝나기 전에 서둘러 성 하나를 점령해야 합니다. 모든 적의 성을 점령하면 승리합니다."

msgid "Find the Crown before Roland's heroes find it. Archibald will need the Crown for the final battle against Roland."
msgstr "롤랜드의 영웅들보다 먼저 왕관을 찾으세요. 아치볼드는 롤랜드와의 최종 전투에 왕관이 필요합니다."

msgid "This is the final battle. Both you and your enemy are armed to the teeth, and all are allied against you. Capture Roland to win the war, and be sure not to lose Archibald in the fight!"
msgstr "최종 전투입니다. 양측 모두 완전 무장했으며 모든 적이 당신에 맞서 동맹을 맺었습니다. 롤랜드를 사로잡아 전쟁에서 승리하고, 전투 중 아치볼드를 잃지 마세요!"

msgid "Arrow's Flight"
msgstr "화살의 비행"

msgid "Island of Chaos"
msgstr "혼돈의 섬"

msgid "The Abyss"
msgstr "심연"

msgid "Uprising"
msgstr "봉기"

msgid "Aurora Borealis"
msgstr "오로라"

msgid "Betrayal's End"
msgstr "배신의 끝"

msgid "Corruption's Heart"
msgstr "타락의 심장"

msgid "The Giant's Pass"
msgstr "거인의 고개"

msgid "Subdue the unruly local lords in order to provide the Empire with facilities to operate in this region."
msgstr "제국이 이 지역에서 활동할 기반을 마련할 수 있도록 반항적인 지역 영주들을 제압하세요."

msgid "Eliminate all opposition in this area. Then the first piece of the artifact will be yours."
msgstr "이 지역의 모든 저항 세력을 제거하세요. 그러면 아티팩트의 첫 번째 조각이 당신의 것이 됩니다."

msgid "The sorceresses to the northeast are rebelling! For the good of the empire you must quash their feeble uprising on your way to the mountains."
msgstr "북동쪽의 소서리스들이 반란을 일으켰습니다! 제국을 위해 산으로 향하는 길에 그 보잘것없는 봉기를 진압해야 합니다."

msgid "Having prepared for your arrival, Kraeger has arranged for a force of necromancers to thwart your quest. You must capture the castle of Scabsdale before the first day of the third week, or the Necromancers will be too strong for you."
msgstr "당신의 도착에 대비한 크레이거가 임무를 방해하려 네크로맨서 군대를 배치했습니다. 셋째 주 첫날이 되기 전에 스캡스데일 성을 점령해야 합니다. 그렇지 않으면 네크로맨서들이 감당하기 어려울 만큼 강해질 것입니다."

msgid "The barbarian despot in this area is, as yet, ignorant of your presence. Quickly, build up your forces before you are discovered and attacked! Secure the region by subduing all enemy forces."
msgstr "이 지역의 야만인 폭군은 아직 당신의 존재를 모릅니다. 발각되어 공격받기 전에 서둘러 병력을 키우세요! 모든 적대 세력을 제압해 지역을 확보해야 합니다."

msgid "The Empire is weak in this region. You will be unable to completely subdue all forces in this area, so take what you can before reprisal strikes. Remember, your true goal is to claim the Helmet of Anduran."
msgstr "제국은 이 지역에서 세력이 약합니다. 모든 세력을 완전히 제압할 수는 없으니 반격이 닥치기 전에 가능한 것을 챙기세요. 진정한 목표는 안두란의 투구를 손에 넣는 것입니다."

msgid "For the good of the Empire, eliminate Kraeger."
msgstr "제국을 위해 크레이거를 제거하세요."

msgid "At last, you have the opportunity and the facilities to rid the Empire of the necromancer's evil. Eradicate them completely, and you will be sung as a hero for all time."
msgstr "마침내 네크로맨서의 사악한 세력을 제국에서 뿌리 뽑을 기회와 수단을 얻었습니다. 그들을 완전히 소탕하면 영원한 영웅으로 칭송받을 것입니다."

msgid "Border Towns"
msgstr "국경 마을"

msgid "Conquer and Unify"
msgstr "정복과 통일"

msgid "Crazy Uncle Ivan"
msgstr "미친 이반 삼촌"

msgid "The Wayward Son"
msgstr "방황하는 아들"

msgid "Ivory Gates"
msgstr "상아의 문"

msgid "The Elven Lands"
msgstr "엘프의 땅"

msgid "The Epic Battle"
msgstr "대서사 전투"

msgid "The Southern War"
msgstr "남부 전쟁"

msgid "Conquer and unite all the enemy tribes. Don't lose the hero Jarkonas, the forefather of all descendants."
msgstr "모든 적대 부족을 정복하고 통합하세요. 모든 후손의 시조인 영웅 자르코나스를 잃지 마세요."

msgid "Your rival, the Kingdom of Harondale, is attacking weak towns on your border! Recover from their first strike and crush them completely!"
msgstr "경쟁국 하론데일 왕국이 국경의 약한 마을들을 공격하고 있습니다! 첫 공격에서 회복한 뒤 그들을 완전히 무너뜨리세요!"

msgid "Find your wayward son Joseph who is rumored to be living in the desolate lands. Do it before the first day of the third month or it will be of no help to your family."
msgstr "황무지에 살고 있다는 소문이 있는 방황하는 아들 조셉을 찾으세요. 셋째 달 첫날이 되기 전에 찾지 못하면 가족에게 아무 도움이 되지 않습니다."

msgid "Rescue your crazy uncle Ivan. Find him before the first day of the fourth month or it will be of no help to your kingdom."
msgstr "미친 이반 삼촌을 구출하세요. 넷째 달 첫날이 되기 전에 찾지 못하면 왕국에 아무 도움이 되지 않습니다."

msgid "Destroy the barbarians who are attacking the southern border of your kingdom! Recover your fallen towns, and then invade the jungle kingdom. Leave no enemy standing."
msgstr "왕국 남쪽 국경을 공격하는 야만인들을 파괴하세요! 빼앗긴 마을을 되찾은 다음 정글 왕국을 침공해 적을 하나도 남기지 마세요."

msgid "Retake the castle of Ivory Gates, which has fallen due to treachery."
msgstr "배신으로 함락된 상아의 문 성을 되찾으세요."

msgid "Gain the favor of the elves. They will not allow trees to be chopped down, so we will send you wood every 2 weeks. You must complete your mission before the first day of the seventh month, or the kingdom will surely fall."
msgstr "엘프들의 호의를 얻으세요. 그들은 나무를 베지 못하게 할 것이므로 2주마다 목재를 보내 주겠습니다. 일곱째 달 첫날이 되기 전에 임무를 완수하지 못하면 왕국은 반드시 무너질 것입니다."

msgid "This is the final battle against your rival kingdom of Harondale. Eliminate everyone, and don't lose the hero Jarkonas VI."
msgstr "경쟁국 하론데일과의 최종 전투입니다. 모두 제거하되 영웅 자르코나스 6세를 잃지 마세요."

msgid "Fount of Wizardry"
msgstr "마법의 샘"

msgid "Power's End"
msgstr "권력의 끝"

msgid "The Eternal Scrolls"
msgstr "영원의 두루마리"

msgid "The Shrouded Isles"
msgstr "장막의 군도"

msgid "Your mission is to vanquish the warring mages in the magical Shrouded Isles. The completion of this task will give you a fighting chance against your rivals."
msgstr "마법의 장막 군도에서 전쟁을 벌이는 마법사들을 물리치세요. 이 임무를 완수하면 경쟁자들과 맞설 기회를 얻을 수 있습니다."

msgid "The location of the great library has been discovered! You must make your way to it, and reclaim the city of Chronos in which it lies."
msgstr "대도서관의 위치가 밝혀졌습니다! 그곳으로 가서 도서관이 자리한 크로노스 도시를 되찾으세요."

msgid "Find the Orb of negation, which is said to be buried in this land. There are clues inscribed on stone obelisks which will help lead you to your prize. Find the Orb before the first day of the sixth month, or your rivals will surely have gotten to the fount before you."
msgstr "이 땅에 묻혀 있다고 전해지는 무효화의 구체를 찾으세요. 돌 오벨리스크에 새겨진 단서가 보물로 이끌 것입니다. 여섯째 달 첫날이 되기 전에 구체를 찾지 못하면 경쟁자들이 먼저 마법의 샘에 도달할 것입니다."

msgid "You must take control of the castle of Magic, where the fount of wizardry lies. Do this and your victory will be supreme."
msgstr "마법의 샘이 있는 마법 성을 장악해야 합니다. 성공하면 완전한 승리를 거둘 것입니다."

msgid "Blood is Thicker"
msgstr "피는 물보다 진하다"

msgid "King and Country"
msgstr "왕과 나라"

msgid "Pirate Isles"
msgstr "해적 군도"

msgid "Stranded"
msgstr "표류"

msgid "Capture the town on the island off the southeast shore in order to construct a boat and travel back towards the mainland. Do not lose the hero Gallavant."
msgstr "남동쪽 해안 앞 섬의 마을을 점령해 배를 건조하고 본토로 돌아가세요. 영웅 갈라반트를 잃지 마세요."

msgid "Find and defeat Martine, the pirate leader, who resides in Pirates Cove. Do not lose Gallavant or your quest will be over."
msgstr "해적의 만에 거주하는 해적 우두머리 마틴을 찾아 물리치세요. 갈라반트를 잃으면 임무는 끝입니다."

msgid "Eliminate all the other forces who oppose the rule of Lord Alberon. Gallavant must not die."
msgstr "알베론 경의 통치에 반대하는 모든 세력을 제거하세요. 갈라반트가 죽어서는 안 됩니다."

msgid "Overthrow the entrenched monarchy of Lord Alberon, and claim all the land in your name. Gallavant must not die."
msgstr "알베론 경의 굳건한 왕정을 무너뜨리고 모든 땅을 당신의 이름으로 차지하세요. 갈라반트가 죽어서는 안 됩니다."

